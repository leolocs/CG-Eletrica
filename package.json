{
  "name": "cg-eletrica-site",
  "version": "1.0.0",
  "description": "Site institucional da CG Elétrica.",
  "private": true,
  "scripts": {
    "clean": "rimraf _site",
    "build:css": "tailwindcss -i ./tailwind.src.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.src.css -o ./assets/css/tailwind.css --watch",
    "dev": "concurrently -n tailwind,eleventy \"npm:watch:css\" \"npx @11ty/eleventy --serve\"",
    "build": "npm run clean && npm run build:css && eleventy",
    "audit": "node scripts/audit-build.js",
    "check": "npm run build && npm run audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolocs/CG-Eletrica.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/leolocs/CG-Eletrica/issues"
  },
  "homepage": "https://cgeletrica.com.br",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "concurrently": "^10.0.5",
    "lucide": "^1.49.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19"
  }
}
