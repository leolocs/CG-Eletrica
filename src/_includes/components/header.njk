{# Recebe `whatsappMessage` (texto simples) do front-matter de cada página #}
<header class="site-header">
  <div class="container header-inner">
    <a href="{{ '/index.html' | url }}" class="brand" aria-label="{{ empresa.nome }} home">
      <img class="brand-mark" src="{{ '/assets/images/cg_logo_icon.webp' | url }}" width="160" height="160" alt="{{ empresa.nome }}" decoding="async" fetchpriority="high" />
    </a>

    <nav class="header-nav" id="primary-navigation" aria-label="Navegação principal">
      {%- for item in navegacao %}
      <a href="{{ item.url | url }}"{% if item.url == page.url or (item.url == "/index.html" and page.url == "/") %} class="active"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <a class="header-cta" href="https://wa.link/vnum8i" target="_blank" rel="noopener noreferrer">Solicitar atendimento</a>

    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="primary-navigation">
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>
