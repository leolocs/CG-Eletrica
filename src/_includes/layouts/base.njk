<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    {%- if themeColor %}
    <meta name="theme-color" content="{{ themeColor }}" />
    {%- endif %}
    {%- if ogTitle %}
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ ogDescription }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ empresa.dominio }}" />
    {%- endif %}
    <link rel="preload" href="{{ '/assets/fonts/manrope-latin-variable.woff2' | url }}" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="{{ '/assets/css/styles.css' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | url }}" />
    <link rel="icon" type="image/webp" href="{{ '/assets/images/cg_logo_icon.webp' | url }}" />
    <script defer src="{{ '/assets/js/main.js' | url }}"></script>
    {%- if jsonLd %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "{{ empresa.nome }}",
        "description": "Engenharia Elétrica e Energia para empresas e empreendimentos no Rio de Janeiro.",
        "areaServed": "Rio de Janeiro, Brasil",
        "url": "{{ empresa.dominio }}",
        "telephone": "{{ empresa.whatsappDisplay }}",
        "sameAs": ["{{ empresa.instagram }}"],
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "Rio de Janeiro",
          "addressCountry": "BR"
        }
      }
    </script>
    {%- endif %}
  </head>
  <body>
    {% include "components/header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}

  </body>
</html>
