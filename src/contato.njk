<section class="page-hero reveal">
  <div class="container">
    <div class="hero-copy">
      <div class="eyebrow">Contato</div>
      <h1>Fale com a CG Elétrica</h1>
      <p class="lead">Atendimento técnico para empresas, empreendimentos e instalações elétricas em todo o Estado do Rio de Janeiro.</p>
    </div>
  </div>
</section>

<section class="reveal">
  <div class="container contact-grid">
    <article class="contact-card">
      <h3>WhatsApp</h3>
      <p>Converse diretamente com a equipe para solicitar informações ou uma avaliação técnica.</p>
      <a class="phone" href="https://wa.me/{{ empresa.whatsapp }}" target="_blank" rel="noreferrer">{{ empresa.whatsappDisplay }}</a>
    </article>
    <article class="contact-card">
      <h3>Atendimento</h3>
      <p>Estado do Rio de Janeiro</p>
    </article>
    <article class="contact-card">
      <h3>Instagram</h3>
      <p>{{ empresa.instagramHandle }}</p>
      <a class="phone" href="{{ empresa.instagram }}" target="_blank" rel="noreferrer">Abrir perfil</a>
    </article>
  </div>
</section>

