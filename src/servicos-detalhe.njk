---
layout: layouts/base.njk
pagination:
  data: servicos
  size: 1
  alias: servico
permalink: "/servicos/{{ servico.slug }}.html"
eleventyComputed:
  title: "{{ servico.title }}"
  description: "{{ servico.description }}"
  whatsappMessage: "{{ servico.whatsappMessage }}"
---
<section class="page-hero">
  <div class="container detail-hero">
    <div class="hero-copy">
      <div class="eyebrow">Serviço</div>
      <h1>{{ servico.heroTitle }}</h1>
      <p class="lead">{{ servico.heroLead }}</p>
    </div>
    <div class="detail-card">
      <h3>Benefício objetivo</h3>
      <p>{{ servico.benefitText }}</p>
    </div>
  </div>
</section>

<section class="reveal">
  <div class="container service-detail">
    <article class="detail-card">
      <h3>Quando esse serviço é necessário?</h3>
      <p>{{ servico.quandoText }}</p>
    </article>
    <article class="detail-card">
      <h3>O que a CG Elétrica executa?</h3>
      <ul>
        {%- for item in servico.executaList %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </article>
    <article class="detail-card">
      <h3>Aplicações</h3>
      <p>{{ servico.aplicacoesText }}</p>
    </article>
    <article class="detail-card">
      <h3>Processo</h3>
      <ol>
        {%- for item in servico.processoList %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ol>
    </article>
    <article class="detail-card">
      <h3>Benefícios técnicos</h3>
      <ul>
        {%- for item in servico.beneficiosList %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </article>
    <article class="detail-card">
      <h3>Responsabilidade técnica</h3>
      <p>{{ servico.responsabilidadeText }}</p>
    </article>
    <article class="detail-card">
      <h3>FAQ curta</h3>
      <div class="faq">
        {%- for item in servico.faq %}
        <div class="faq-item"><strong>{{ item.pergunta }}</strong>{{ item.resposta }}</div>
        {%- endfor %}
      </div>
    </article>
  </div>
</section>

{% from "components/cta-final.njk" import ctaFinal with context %}
{{ ctaFinal(servico.ctaEyebrow, (servico.whatsappMessageFinal or servico.whatsappMessage), servico.ctaButtonText) }}
